<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header row with switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AUTOTUNE"
                android:textColor="@color/accent_gold"
                android:textSize="10sp"
                android:letterSpacing="0.15"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_auto_tune"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                app:thumbTint="@color/accent_gold"
                app:trackTint="@color/surface_variant"/>

        </LinearLayout>

        <!-- Collapsible options -->
        <LinearLayout
            android:id="@+id/group_auto_tune_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Strength -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Strength"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="70%"
                    android:textColor="@color/accent_gold"
                    android:textSize="13sp"
                    android:gravity="end"/>
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_auto_tune_strength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="100"
                android:value="70"
                android:layout_marginBottom="10dp"
                app:thumbColor="@color/accent_gold"
                app:trackColorActive="@color/accent_gold"
                app:trackColorInactive="@color/surface_variant"/>

            <!-- Scale picker -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scale"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/spinner_scale"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/spinner_bg"
                android:popupBackground="@color/surface_variant"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
